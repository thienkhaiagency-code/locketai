#!name = Locket Gold - iutdyy
#!desc = Crack Locket Gold, AI Filter, Photobooth (iutdyy)
#!author = iutdyy
#!homepage = https://github.com/iutdyy

[Rule]
# Chặn QUIC/UDP cho Locket
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,locketcamera.com),(PROTOCOL,UDP)),REJECT

# Chặn Sentry
DOMAIN-SUFFIX,sentry.io,REJECT
DOMAIN-SUFFIX,ingest.sentry.io,REJECT

[Host]
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0

[Header Rewrite]
# Xóa Cache / ETag trên RevenueCat
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-remove x-revenuecat-etag
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-remove X-RevenueCat-ETag
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-remove if-none-match
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-remove If-None-Match
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-remove if-modified-since
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-remove If-Modified-Since

# Xóa Cache / ETag trên Firebase Remote Config
http-request ^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-remove if-none-match
http-request ^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-remove If-None-Match
http-request ^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-remove if-modified-since
http-request ^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-remove If-Modified-Since
http-request ^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+ header-remove x-goog-if-none-match

# Xóa Cache / ETag trên Locket Camera API
http-request ^https?:\/\/api\.locketcamera\.com\/.+ header-remove if-none-match
http-request ^https?:\/\/api\.locketcamera\.com\/.+ header-remove If-None-Match
http-request ^https?:\/\/api\.locketcamera\.com\/.+ header-remove if-modified-since
http-request ^https?:\/\/api\.locketcamera\.com\/.+ header-remove If-Modified-Since

[Script]
# Locket Gold - Xóa Header RevenueCat và Firebase
deleteHeader_RC = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=YOUR_GITHUB_RAW_URL/deleteHeader_Firebase.js,timeout=60
deleteHeader_Firebase = type=http-request,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+,script-path=YOUR_GITHUB_RAW_URL/deleteHeader_RC.js,timeout=60

# Locket Gold - Kích hoạt quyền thuê bao và tính năng 45s
revenuecat = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=YOUR_GITHUB_RAW_URL/evenuecat.js,requires-body=true,max-size=-1,timeout=60
locket_rc = type=http-response,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+,script-path=YOUR_GITHUB_RAW_URL/locketfix.js,requires-body=true,max-size=-1,timeout=60

# Locket Photobooth Engine
locket_pb_req = type=http-request,pattern=^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/generateFilteredImage,script-path=YOUR_GITHUB_RAW_URL/locket_pb_req.js,requires-body=true,max-size=-1,timeout=60

# Locket Huy hiệu Profile và Mạng lưới bạn bè VIP
locket_change_profile = type=http-request,pattern=^https:\/\/api\.locketcamera\.com\/changeProfileInfo,script-path=YOUR_GITHUB_RAW_URL/locket_change_profile.js,timeout=60
locket_filter_resp = type=http-response,pattern=^https?:\/\/api\.locketcamera\.com\/.+,requires-body=true,max-size=-1,script-path=YOUR_GITHUB_RAW_URL/locket_filter_resp.js,timeout=60

[MITM]
ca-passphrase = 9QkClI9j
ca-p12 = 
enable = true
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com, *.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net
